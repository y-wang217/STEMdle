{
  "_comment": "Single source of truth for the agent pipeline (ported from y-wang217/ap-academy-landing). gate_commands are the fast local subset of CI that the Stop hook runs before a session may finish; ci.yml also runs check:procedural, the production build and Playwright. human_merge_paths: a PR touching any of these is labelled needs-human-merge by claude-review.yml and is never auto-merged. review_round_cap: bot change requests before the owner is pinged.",
  "repo": "y-wang217/stemdle",
  "owner_login": "y-wang217",
  "default_branch": "main",
  "branch_prefixes": ["req/", "claude/"],
  "labels": {
    "human_merge": "needs-human-merge",
    "migration": "migration"
  },
  "wip_limit": 3,
  "review_round_cap": 3,
  "gate_commands": [
    "npm run typecheck",
    "npm run lint",
    "npm run test:py",
    "npm test"
  ],
  "gate_ignore_paths": [
    "docs/",
    ".claude/",
    ".github/",
    "README.md",
    "PIPELINE.md",
    "CLAUDE.md",
    "AGENTS.md",
    "screenshots/"
  ],
  "e2e_paths": [
    "src/app/",
    "src/components/",
    "tests/e2e/",
    "playwright.config.ts",
    "next.config.ts"
  ],
  "human_merge_paths": [
    ".env",
    ".github/",
    ".claude/hooks/",
    ".claude/settings.json",
    ".claude/pipeline.json",
    "supabase/migrations/",
    "src/lib/security/",
    "src/lib/game/engine",
    "src/lib/game/identity",
    "src/lib/game/leaderboard",
    "src/app/api/admin/login/",
    "src/app/api/cron/",
    "validator/server",
    "validator/mathdle_validator.py",
    "src/lib/factory/validate.ts",
    "src/lib/lean/",
    "vercel.json",
    "package.json",
    "package-lock.json"
  ]
}
