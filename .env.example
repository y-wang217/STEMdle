# --- Database (Supabase Postgres or any Postgres 15+) ---
# Server-side only. Use the Supabase connection string for the `postgres` role
# (Project Settings → Database). Never expose this to the browser.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mathdle
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mathdle_test

# --- Secrets ---
# 32+ random bytes, used to HMAC anonymous player tokens and admin sessions.
APP_SECRET=change-me-to-a-long-random-string
# Shared secret for /api/cron/* (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=change-me

# --- Question generation ---
# Provider for "Generate batch": `anthropic` (requires ANTHROPIC_API_KEY) or
# `procedural` (built-in parametrized templates; development adapter, no key needed).
GENERATOR_PROVIDER=procedural
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Max generation batches per admin per hour.
GENERATION_RATE_LIMIT_PER_HOUR=20

# --- Validator ---
# Leave VALIDATOR_URL empty to spawn `python3 validator/cli.py` locally.
# For Vercel, deploy validator/server.py elsewhere and set both.
VALIDATOR_URL=
VALIDATOR_TOKEN=
PYTHON_BIN=python3

# --- Game ---
# Day #1 of the challenge numbering (America/Toronto calendar date).
MATHDLE_EPOCH=2026-11-01
# Minimum approved future days before an alert fires.
RESERVE_TARGET_DAYS=7
# Optional: POST JSON alerts to a webhook (Slack-compatible {text}).
ALERT_WEBHOOK_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lean 4 + Mathlib formal verification ---
# local | vercel-sandbox | disabled. Default: vercel-sandbox if a snapshot is configured, else local if LEAN_PROJECT_DIR has Mathlib.
LEAN_RUNNER=local
# Local dev: a Lake project built from lean/ (keep it OUTSIDE the repo; its .lake is ~7 GB and upsets the Next file watcher).
LEAN_PROJECT_DIR=/path/to/mathdle-lean
LEAN_BIN_DIR=/path/to/lean-4.35.0-linux/bin
# Production (Vercel Sandbox): snapshot with Lean + Mathlib; app_settings.lean_sandbox_snapshot_id overrides this after a refresh.
LEAN_SANDBOX_SNAPSHOT_ID=
LEAN_SANDBOX_REGION=yul1
LEAN_SANDBOX_VCPUS=4
LEAN_CHECK_TIMEOUT_MS=150000
LEAN_MAX_JOBS_PER_RUN=4
LEAN_AI_PROOF_ROUNDS=1
